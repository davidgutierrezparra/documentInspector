<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="abrirDocumento" prefHeight="667.0" prefWidth="1142.0" styleClass="color1-1"
            stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.unad.documentinspector.FuncionalidadesController">

    <children>

        <Label layoutX="451.0" layoutY="19.0" text="Seguimiento Documental">
            <font>
                <Font name="Arial Bold" size="20.0"/>
            </font>
        </Label>


        <HBox spacing="10"/>


        <ScrollPane fitToWidth="true" layoutX="170.0" layoutY="50.0" prefHeight="587.0" prefWidth="802.0">
            <content>
                <VBox fx:id="contenedorPaginas" alignment="TOP_CENTER" spacing="10"
                      style="-fx-background-color: #e5e7eb;      -fx-padding: 10;"/>
            </content>
        </ScrollPane>


        <Button layoutX="542.0" layoutY="641.0" mnemonicParsing="false" onAction="#cerrarDocumento" text="Cerrar" textAlignment="CENTER"/>
    </children>


</AnchorPane>
