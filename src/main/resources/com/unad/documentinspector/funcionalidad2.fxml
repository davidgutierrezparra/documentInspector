<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="funcionalidad2" prefHeight="667.0" prefWidth="1142.0" styleClass="color1-1"
            stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.unad.documentinspector.FuncionalidadesController">
    <children>

        <Label layoutX="37.0" layoutY="17.0" text="Usuarios">
            <font>
                <Font name="Arial Bold" size="20.0"/>
            </font>
        </Label>

        <TableView fx:id="tablaFuncion2" layoutX="38.0" layoutY="89.0" prefHeight="602.0" prefWidth="837.0"
                   styleClass="tabla-apli" stylesheets="@../css/styles.css">
            <columns>
                <TableColumn fx:id="nombres" prefWidth="179.0" text="Nombres"/>
                <TableColumn fx:id="identificacion" prefWidth="111.0" text="Identificacion"/>
                <TableColumn fx:id="cargo" prefWidth="116.0" text="Cargo"/>
                <TableColumn fx:id="area" prefWidth="136.0" text="Area"/>
                <TableColumn fx:id="docuemntosCargados" prefWidth="148.0" text="Documentos Cargados"/>
                <TableColumn fx:id="firma" prefWidth="145.0" text="Firma"/>
            </columns>
        </TableView>
        <Button layoutX="38.0" layoutY="63.0" mnemonicParsing="false" text="Registrar" onAction="#mostrarComponentes"
                textAlignment="CENTER"/>

        <Label layoutX="954.0" layoutY="283.0" opacity="0.0" text="Nuevo Usuarios">
            <font>
                <Font name="Arial Bold" size="15.0"/>
            </font>
        </Label>

        <TextField fx:id="nom" layoutX="890.0" layoutY="322.0" opacity="0.0" prefHeight="25.0" prefWidth="245.0"
                   promptText="Nombre de usuario"/>
        <TextField fx:id="cedula" layoutX="890.0" layoutY="356.0" opacity="0.0" prefHeight="25.0" prefWidth="245.0"
                   promptText="Identificacion de usuario"/>
        <ComboBox fx:id="rol" layoutX="890.0" layoutY="389.0" opacity="0.0" prefHeight="25.0" prefWidth="245.0"
                  promptText="Seleccione un rol"/>
        <ComboBox fx:id="cargos" layoutX="890.0" layoutY="422.0" opacity="0.0" prefHeight="25.0" prefWidth="245.0"
                  promptText="Seleccione un cargo"/>
        <Button fx:id="guardar" layoutX="983.0" layoutY="467.0" mnemonicParsing="false" opacity="0.0" text="Guardar"
                onAction="#guardarUsuario" textAlignment="CENTER"/>


    </children>


</AnchorPane>
