                    </font>
                </Button>
            </children>
        </AnchorPane>
    </top>

    <left>
        <AnchorPane prefHeight="667.0" prefWidth="583.0" BorderPane.alignment="CENTER">
            <children>

                <TextField fx:id="userIngreso" layoutX="134.0" layoutY="348.0" prefHeight="42.0" prefWidth="355.0"
