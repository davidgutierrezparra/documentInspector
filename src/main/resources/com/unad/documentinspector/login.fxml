                </PasswordField>

                <!--                <TextField fx:id="contrasenaIngreso" styleClass="text-field" layoutX="134.0" layoutY="425.0" prefHeight="42.0" prefWidth="355.0"-->
                <!--                           promptText="Contraseña">-->
                <!--                    <font>-->
                <!--                        <Font size="14.0"/>-->
                <!--                    </font>-->
                <!--                </TextField>-->

                <Button layoutX="86.0" layoutY="503.0" mnemonicParsing="false" onAction="#iniciarSesion" opacity="0.0"
                        prefHeight="52.0" prefWidth="412.0" styleClass="boton-menu">
                    <font>
                        <Font size="18.0"/>
                    </font>
                </Button>
            </children>
        </AnchorPane>
    </left>

    <center>
        <AnchorPane prefHeight="608.0" prefWidth="1143.0" BorderPane.alignment="CENTER"/>
    </center>

    <right>
        <AnchorPane prefHeight="667.0" prefWidth="10.0" BorderPane.alignment="CENTER"/>
    </right>

    <bottom>
