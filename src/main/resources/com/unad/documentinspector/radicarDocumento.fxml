<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="radicarDocumento" prefHeight="667.0" prefWidth="1142.0" styleClass="color1-1"
            stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.unad.documentinspector.FuncionalidadesController">

    <children>

        <Label layoutX="37.0" layoutY="17.0" text="Registro Documental">
            <font>
                <Font name="Arial Bold" size="20.0"/>
            </font>
        </Label>

        <TextField fx:id="nombreDocumento" layoutX="37.0" layoutY="62.0" prefHeight="25.0" prefWidth="247.0"
                   promptText="Ingrese el nombre del documento"/>

        <HBox spacing="10"/>


        <Button layoutX="37.0" layoutY="101.0" onAction="#seleccionarPdf" text="Cargar PDF"/>
        <Label fx:id="lblArchivo" layoutX="37.0" layoutY="138.0" text="Ningún archivo seleccionado"/>

        <ComboBox fx:id="tipoDocumento" layoutX="36.0" layoutY="165.0" promptText="Seleccione un tipo documento"/>
        <ComboBox fx:id="asignar" layoutX="36.0" layoutY="203.0" promptText="Asignar documento"/>

        <ScrollPane fitToWidth="true" layoutX="334.0" layoutY="5.0" prefHeight="631.0" prefWidth="802.0">
            <content>
                <VBox fx:id="contenedorPaginas" alignment="TOP_CENTER" spacing="10"
                      style="-fx-background-color: #e5e7eb;      -fx-padding: 10;"/>
            </content>
        </ScrollPane>

        <Button layoutX="681.0" layoutY="641.0" mnemonicParsing="false" onAction="#guardarDocumento" text="Guardar"
                textAlignment="CENTER"/>
        <Button layoutX="744.0" layoutY="641.0" mnemonicParsing="false" onAction="#cerrarDocumento" text="Cerrar"
                textAlignment="CENTER"/>
    </children>


</AnchorPane>
